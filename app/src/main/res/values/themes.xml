<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the Compose app. Uses a neutral NoActionBar parent so
         the legacy Material (Material1) widget styling doesn't clash with the
         Compose Material3 UI that paints on top. The window background matches
         the Compose surface color so the pre-Compose splash crossfade is
         seamless. -->
    <style name="Theme.Opencode" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
