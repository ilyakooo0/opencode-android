<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Minimal platform theme. All real theming is done in Compose (OpencodeTheme);
      this only removes the action bar and gives a neutral window background so
      there's no flash before the first frame.
    -->
    <style name="Theme.OpencodeAndroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
