<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera captures are written to cache/captures and shared with the camera app via
         the app's FileProvider (see AndroidManifest). -->
    <cache-path name="captures" path="captures/" />
    <!-- "Open externally" writes a viewed file's content to cache/external and hands a
         content:// URI to another app via ACTION_VIEW (see FileViewScreen). -->
    <cache-path name="external" path="external/" />
    <!-- "Share image" writes a viewed image's PNG to cache/share and hands a content:// URI
         to the chooser via ACTION_SEND (see RemoteImage.shareImage). -->
    <cache-path name="share" path="share/" />
</paths>
