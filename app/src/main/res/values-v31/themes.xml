<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Opencode" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Android 12+ system splash screen: use the window background color
             so the post-splash crossfade into the Compose UI is seamless. The
             Compose UI paints its own background, so we only set the poster
             color and a system icon here. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:drawable/ic_dialog_info</item>
    </style>
</resources>
