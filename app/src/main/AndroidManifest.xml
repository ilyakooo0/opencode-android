<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Camera is used opportunistically for attachment capture via the system camera app
         (ACTION_IMAGE_CAPTURE), so it's optional — devices without a camera still install. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".OpencodeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpencodeAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="33"
            android:theme="@style/Theme.OpencodeAndroid.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Receive images shared from other apps (single or multiple) to attach to a prompt. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Deep link to a session: opencode://session/{sessionId} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="session" />
            </intent-filter>
            <!-- Deep links: opencode://file/{path} and opencode://new -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="new" />
            </intent-filter>
        </activity>

        <service
            android:name=".notification.RunForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Handles notification action buttons (permission responses, inline reply). Not
             exported: only the app's own PendingIntents target it. -->
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget listing recent sessions. -->
        <receiver
            android:name=".platform.SessionsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sessions_widget_info" />
        </receiver>

        <!-- Serves the widget's session list rows. Bound by the system with BIND_REMOTEVIEWS.
             exported="true" is required: the AppWidget host runs in the launcher/system process
             (a different process from the app), so it can only bindService to a service that's
             visible outside the app. The BIND_REMOTEVIEWS permission restricts *who* can bind to
             the system; exported="false" would make the service invisible to the host and the
             widget's RemoteViewsService adapter would never populate. -->
        <service
            android:name=".platform.SessionsWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <!-- Quick-settings tile: start a new session. Bound by the system. -->
        <service
            android:name=".platform.NewSessionTileService"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/tile_new_session"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Serves camera-capture temp files (cache/captures) to the system camera app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
